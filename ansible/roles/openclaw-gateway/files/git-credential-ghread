#!/bin/sh
# IaC4 git-Credential-Helper (Issue #201, 2026-11-22).
# Liegt im config-Mount (/home/node/.openclaw/tools/) und wird systemweit als
# credential.helper eingetragen. Quelle ist ausschliesslich das vom Deploy
# geschriebene 0600-File .gh-read-token - keine zweite Secret-Kopie, kein
# Env-Zugriff. Damit bleibt ein Push auch dann korrekt, wenn ein Ablauf
# GH_TOKEN in einer Shell ueberschreibt.
set -eu

case "${1:-}" in
  get)
    token_file="/home/node/.openclaw/workspace/.gh-read-token"
    [ -r "$token_file" ] || exit 0
    token=$(tr -d '[:space:]' < "$token_file") || exit 0
    [ -n "$token" ] || exit 0
    printf 'username=x-access-token\npassword=%s\n' "$token"
    ;;
esac

exit 0
