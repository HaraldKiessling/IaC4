{% set am = oc.agent_models | default(openclaw_agent_models, true) %}
{% set subagents_defaults = oc.subagents_defaults | default({}, true) %}
{% set allow_agents = oc.subagents_allow_agents | default([], true) %}
{% set subagents_deny = oc.subagents_tools_deny | default([], true) %}
{% set agent_workspaces = oc.agent_workspaces | default(false, true) %}
{% set orch_tool_scope = oc.orchestrator_tool_scope | default('', true) %}
{% set subagent_tools = oc.subagent_tools | default([], true) %}
{% set agent_thinking = oc.agent_thinking | default({}, true) %}
{# Google-Drive-MCP (Issue #171): enabled nur wenn ALLE 4 Secrets gesetzt sind (ein dediziertes Konto).
   Token-Hygiene (2026-10-05, Owner-Entscheid 'A'): KEINE Credentials mehr in openclaw.json –
   weder Literale noch ${env}-Refs. Der stdio-MCP liest die Token-Datei stattdessen ueber
   GOOGLE_DRIVE_MCP_TOKEN_PATH; der Env-Key endet auf _PATH (kein sensibler Wert -> keine
   'literal sensitive value'-Warnung im doctor). Die Wertquelle bleibt die GH-Secret-Kette
   (Workflow 04): Ansible rendert daraus gdrive/tokens.json + gdrive/gcp-oauth.keys.json auf den
   Host (instance.yml), docker-compose.yml.j2 mountet sie read-only in den Container.
   Das Google-Konto ist AUSSCHLIESSLICH fuer die OC-Instanzen (dev+prod, oc1-3) gedacht;
   bewusst EIN gemeinsamer Secret-Satz, keine Rotation und keine pro-Instanz-Isolation. #}
{# Gate: ohne die 4 Secrets -> enabled:false, kein Mount (identisches Gate in
   docker-compose.yml.j2 und instance.yml). #}
{% set _gdrive_ready = (openclaw_gdrive_client_id | default('', true) | length > 0)
                       and (openclaw_gdrive_client_secret | default('', true) | length > 0)
                       and (openclaw_gdrive_refresh_token | default('', true) | length > 0)
                       and (openclaw_gdrive_access_token | default('', true) | length > 0) %}
{
  "gateway": {
    "mode": "local",
    "port": {{ oc.port }},
    "bind": "lan",
{% if oc_trusted_proxies | default([]) | length > 0 %}
    "trustedProxies": {{ oc_trusted_proxies | tojson }},
    "allowRealIpFallback": false,
{% endif %}
    "auth": {
      "mode": "token",
      "allowTailscale": true
{% if oc_gateway_token | default('') | length > 0 %},
      "token": "{{ oc_gateway_token }}"
{% endif %}
    },
    "controlUi": {
      "allowedOrigins": ["http://localhost:{{ oc.port }}", "http://127.0.0.1:{{ oc.port }}"]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace"
{% if am.get('Orchestrator') %},
      "model": {
        "primary": "{{ am['Orchestrator'].primary }}",
        "fallbacks": {{ am['Orchestrator'].fallbacks | tojson }}
      }
{% endif %},
      "memorySearch": {
        "provider": "local"
      }
{% if skip_bootstrap | default(false) | bool %},
      "skipBootstrap": true
{% endif %}
{% if subagents_defaults %},
      "subagents": {{ subagents_defaults | tojson }}
{% endif %}
    }
{% if oc.agents | length > 0 %},
    "list": [
{% for a in oc.agents %}{% set agent_id = a | lower | replace(' ', '-') %}      {
        "id": "{{ agent_id }}",
        "name": "{{ a }}",
        "model": {
          "primary": "{{ am[a].primary }}",
          "fallbacks": {{ am[a].fallbacks | tojson }}
        }
{% if agent_thinking.get(a) %},
        "thinkingDefault": "{{ agent_thinking.get(a) }}"
{% endif %}
{% if agent_workspaces and agent_id != 'orchestrator' %},
        "workspace": "/home/node/.openclaw/workspace/{{ agent_id }}"
{% endif %}


{% if allow_agents and agent_id == 'orchestrator' %},
        "subagents": {
          "allowAgents": {{ allow_agents | tojson }}
        }
{% endif %}
      }{{ "," if not loop.last else "" }}
{% endfor %}    ]
{% endif %}
  },
  "memory": {
    "backend": "qmd"
  },
  "plugins": {
    "entries": {
{% if oc_websearch_api_key | default('') | length > 0 %}      "perplexity": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "{{ oc_websearch_api_key }}"
          }
        }
      }
{% else %}      "perplexity": {
        "enabled": false
      }
{% endif %}    }
  },
  "tools": {
    "web": {
      "search": {
{% if oc_websearch_api_key | default('') | length > 0 %}        "provider": "perplexity"
{% else %}        "provider": "none"
{% endif %}      }
    }
{% if oc_bitwarden_active | default(false) | bool %},
    "exec": {
      "mode": "ask",
      "strictInlineEval": true
    }
{% endif %}
{% if subagents_deny %},
    "subagents": {
      "tools": {
        "deny": {{ subagents_deny | tojson }}
      }
    }
{% endif %}
  }{% if openclaw_browser_ssrf_hostnames | default([]) | length > 0 %},
  "browser": {
    "ssrfPolicy": {
      "allowedHostnames": {{ openclaw_browser_ssrf_hostnames | tojson }}
    }
  }{% endif %},
  "models": {
    "providers": {
{% set ns = namespace(first=true) %}
{% for pname, penv in openclaw_provider_envs.items() %}
{% set pkey = lookup('env', penv) | default('', true) if penv else '' %}
{% if (pkey | length > 0) or (pname == 'ollama') %}
{% set pm = openclaw_provider_models[pname] %}
{% if not ns.first %},{% endif %}{% set ns.first = false %}
      "{{ pname }}": {
        "api": "{{ pm.api }}"
{% if pkey | length > 0 %},
        "apiKey": "{{ pkey }}"
{% endif %}
{% if pm.baseUrl is defined and pm.baseUrl %},
        "baseUrl": "{{ pm.baseUrl }}"
{% endif %}
{% if pm.models is defined %},
        "models": {{ pm.models | tojson }}
{% endif %}
      }
{% endif %}
{% endfor %}
    }
  },
  "channels": {
    "telegram": {
{% if oc_telegram_bot_token | default('') | length > 0 %}
      "enabled": true,
      "botToken": "{{ oc_telegram_bot_token }}"
{% if oc_bitwarden_active | default(false) | bool %},
      "execApprovals": {
        "enabled": true,
        "approvers": {{ openclaw_exec_approvers | tojson }},
        "target": "dm"
      }
{% endif %}
{% else %}
      "enabled": false
{% endif %}
    }
  },
  "mcp": {
    "servers": {
      "gdrive": {
{% if _gdrive_ready %}
        "enabled": true,
        "command": "google-drive-mcp",
        "transport": "stdio",
        "env": {
          "GOOGLE_DRIVE_MCP_SCOPES": "drive",
          "GOOGLE_DRIVE_MCP_TOKEN_PATH": "/home/node/.config/google-drive-mcp/tokens.json"
        }
{% else %}
        "enabled": false
{% endif %}
      }
    }
  }
}
