{
  "gateway": {
    "mode": "local",
    "port": {{ oc.port }},
    "bind": "lan",
    "auth": {
      "mode": "token",
      "allowTailscale": true
{% if oc_gateway_token | default('') | length > 0 %},
      "token": "{{ oc_gateway_token }}"
{% endif %}
    },
    "controlUi": {
      "allowedOrigins": ["http://localhost:{{ oc.port }}", "http://127.0.0.1:{{ oc.port }}"]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace"
    }
{% if oc.agents | length > 0 %},
    "list": [
{% for a in oc.agents %}      {
        "name": "{{ a }}",
        "model": {
          "primary": "{{ openclaw_agent_models[a].primary }}",
          "fallbacks": {{ openclaw_agent_models[a].fallbacks | tojson }}
        }
      }{{ "," if not loop.last else "" }}
{% endfor %}    ]
{% endif %}
  },
  "memory": {
    "backend": "qmd"
  },
  "plugins": {
    "entries": {
      "perplexity": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "{{ oc_websearch_api_key }}"
          }
        }
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "perplexity"
      }
    }
  },
  "providers": {
{% for pname, penv in openclaw_provider_envs.items() %}
{% set pkey = lookup('env', penv) | default('', true) if penv else '' %}
{% if pkey | length > 0 %}
    "{{ pname }}": {
      "apiKey": "{{ pkey }}"
    }{{ "," if not loop.last else "" }}
{% elif pname == 'ollama' %}
    "ollama": {
      "baseUrl": "http://ollama:11434"
    }{{ "," if not loop.last else "" }}
{% endif %}
{% endfor %}
  },
  "models": {
    "providers": {
{% set ns = namespace(first=true) %}
{% for pname, penv in openclaw_provider_envs.items() %}
{% set pkey = lookup('env', penv) | default('', true) if penv else '' %}
{% if (pkey | length > 0) or (pname == 'ollama') %}
{% set pm = openclaw_provider_models[pname] %}
{% if not ns.first %},{% endif %}{% set ns.first = false %}
      "{{ pname }}": {
        "api": "{{ pm.api }}"
{% if pm.baseUrl is defined and pm.baseUrl %},
        "baseUrl": "{{ pm.baseUrl }}"
{% endif %}
{% if pm.models is defined %},
        "models": {{ pm.models | tojson }}
{% endif %}
      }
{% endif %}
{% endfor %}
    }
  },
  "channels": {
    "telegram": {
{% if oc_telegram_bot_token | default('') | length > 0 %}
      "enabled": true,
      "botToken": "{{ oc_telegram_bot_token }}"
{% else %}
      "enabled": false
{% endif %}
    }
  }
}
