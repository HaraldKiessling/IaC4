{
  "gateway": {
    "mode": "local",
    "port": {{ oc.port }},
    "bind": "lan",
    "auth": {
      "mode": "token",
      "allowTailscale": true
{% if oc_gateway_token | default('') | length > 0 %},
      "token": "{{ oc_gateway_token }}"
{% endif %}
    },
    "controlUi": {
      "allowedOrigins": ["http://localhost:{{ oc.port }}", "http://127.0.0.1:{{ oc.port }}"]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace"
    }
{% if oc.agents | length > 0 %},
    "list": [
{% for a in oc.agents %}      {
        "name": "{{ a }}",
        "model": {
          "primary": "{{ openclaw_agent_models[a].primary }}",
          "fallbacks": {{ openclaw_agent_models[a].fallbacks | tojson }}
        }
      }{{ "," if not loop.last else "" }}
{% endfor %}    ]
{% endif %}
  },
  "memory": {
    "backend": "qmd"
  },
  "plugins": {
    "entries": {
      "perplexity": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "{{ oc_websearch_api_key }}"
          }
        }
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "perplexity"
      }
    }
  },
  "providers": {
    "{{ oc_llm_provider }}": {
      "apiKey": "{{ oc_llm_api_key }}"
    }
{% if oc_google_api_key | default('') | length > 0 %},
    "google": {
      "apiKey": "{{ oc_google_api_key }}"
    }
{% endif %}
  },
  "channels": {
    "telegram": {
{% if oc_telegram_bot_token | default('') | length > 0 %}
      "enabled": true,
      "botToken": "{{ oc_telegram_bot_token }}"
{% else %}
      "enabled": false
{% endif %}
    }
  }
}
