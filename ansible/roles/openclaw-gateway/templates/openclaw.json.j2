{# =============================================================================
   OpenClaw-Gateway-Config (ADR-025): Multi-Instanz, SSoT group_vars/<target>.yml

   #126 PILOT Familien-Instanz (oc4, dev) – optionale Erweiterungen (nur bei Bedarf
   je Instanz gesetzt, oc1/oc2/oc3 bleiben unveraendert):
   - oc.person_agents        : Personen-Agents mit eigenem workspace + agentDir (S3)
   - oc.telegram_accounts    : Multi-Account-Telegram (S4): accounts + defaultAccount + dmPolicy
   - oc.secrets_ref          : Provider-Keys als SecretRef "${ENV}" statt Plaintext (S2/S6)
   Konzept (aktuell): docs/arc42/07_verteilungssicht.md („OpenClaw oc4 – Familien-Instanz“)
   + docs/adr/ADR-025-openclaw-deployment.md; alte Konzept-Datei
   iac4-pilot/konzept-pilot-oc1-dev.md (§3) historisch (existiert nicht, keine Neuanlage).
   ⚠️ bind: "lan" im Container BLEIBT (Konzept §3 Empfehlung (a)): Exposition ist trotzdem
   loopback-only via Host-Port "127.0.0.1:<port>:<port>" + tailscale serve (ADR-025).
   Container-internes "loopback" waere ueber den publizierten Port NICHT erreichbar
   (Docker-Bridge-Caveat) und wuerde Docker-DNS (Ollama/Qdrant) verlieren.
   ============================================================================= #}
{% set am = oc.agent_models | default(openclaw_agent_models, true) %}
{% set subagents_defaults = oc.subagents_defaults | default({}, true) %}
{% set allow_agents = oc.subagents_allow_agents | default([], true) %}
{% set subagents_deny = oc.subagents_tools_deny | default([], true) %}
{% set agent_workspaces = oc.agent_workspaces | default(false, true) %}
{% set orch_tool_scope = oc.orchestrator_tool_scope | default('', true) %}
{% set subagent_tools = oc.subagent_tools | default([], true) %}
{% set agent_thinking = oc.agent_thinking | default({}, true) %}
{# #126: Aktive Telegram-Accounts vorab berechnen (nur Accounts mit gesetztem Token-Env werden
   gerendert – gleiches Muster wie Provider: „nur gesetzte Keys landen in der Config“; Q3 offen:
   bis Tokens vorliegen bleibt der Account unsichtbar, Gateway-Start failt nicht). #}
{% set acc_ns = namespace(active=[]) %}
{% if oc.telegram_accounts is defined and oc.telegram_accounts | length > 0 %}
{% for acc_id, acc_env in oc.telegram_accounts.items() %}
{% set acc_tok = lookup('env', acc_env) | default('', true) %}
{% if acc_tok | length > 0 %}{% set _ = acc_ns.active.append(acc_id) %}{% endif %}
{% endfor %}
{% endif %}
{
  "gateway": {
    "mode": "local",
    "port": {{ oc.port }},
    "bind": "lan",
    "auth": {
      "mode": "token",
      "allowTailscale": true
{% if oc_gateway_token | default('') | length > 0 %},
      "token": "{{ oc_gateway_token }}"
{% endif %}
    },
    "controlUi": {
      "allowedOrigins": ["http://localhost:{{ oc.port }}", "http://127.0.0.1:{{ oc.port }}"]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace"
{% if am.get('Orchestrator') %},
      "model": {
        "primary": "{{ am['Orchestrator'].primary }}",
        "fallbacks": {{ am['Orchestrator'].fallbacks | tojson }}
      }
{% endif %},
      "memorySearch": {
        "provider": "local"
      }
{% if skip_bootstrap | default(false) | bool %},
      "skipBootstrap": true
{% endif %}
{% if subagents_defaults %},
      "subagents": {{ subagents_defaults | tojson }}
{% endif %}
    }
{% if (oc.agents | length > 0) or (oc.person_agents is defined and oc.person_agents | length > 0) %},
    "list": [
{% if oc.person_agents is defined and oc.person_agents | length > 0 %}
{# 2026-09-06 (Harald): Agents mit eigenem workspace + agentDir (S3, getrennter Speicher).
   Keine allowAgents-Restriktion mehr – Repo-/Recherche-Agents koennen frei delegieren. #}
{% for pid in oc.person_agents %}      {
        "id": "{{ pid }}",
        "name": "{{ pid }}",
        "workspace": "/home/node/.openclaw/workspace/{{ pid }}",
        "agentDir": "/home/node/.openclaw/agents/{{ pid }}/agent"
      }{{ "," if not loop.last else "" }}
{% endfor %}
{% else %}
{% for a in oc.agents %}{% set agent_id = a | lower | replace(' ', '-') %}      {
        "id": "{{ agent_id }}",
        "name": "{{ a }}",
        "model": {
          "primary": "{{ am[a].primary }}",
          "fallbacks": {{ am[a].fallbacks | tojson }}
        }
{% if agent_thinking.get(a) %},
        "thinkingDefault": "{{ agent_thinking.get(a) }}"
{% endif %}
{% if agent_workspaces and agent_id != 'orchestrator' %},
        "workspace": "/home/node/.openclaw/workspace/{{ agent_id }}"
{% endif %}


{% if allow_agents and agent_id == 'orchestrator' %},
        "subagents": {
          "allowAgents": {{ allow_agents | tojson }}
        }
{% endif %}
      }{{ "," if not loop.last else "" }}
{% endfor %}
{% endif %}    ]
{% endif %}
  }{% if acc_ns.active | length > 0 %},
  "bindings": [
{# #126/S6: Bindings – explizite DM- (telegram_dm_bindings) und Gruppen-Bindings
   (telegram_group_bindings, peer group id). Rückwärtskompatibel: ohne diese Felder wird
   KEIN Binding gerendert (oc1/oc2/oc3 unverändert, Golden-File-OC1 bleibt). #}
{% set b_ns = namespace(rendered=false) %}
{% if oc.telegram_dm_bindings is defined %}
{% for dm in oc.telegram_dm_bindings %}
{% if dm.account in acc_ns.active %}{% if b_ns.rendered %},{% endif %}{% set b_ns.rendered = true %}
    {
      "agentId": "{{ dm.agent }}",
      "match": {
        "channel": "telegram",
        "accountId": "{{ dm.account }}"
      }
    }
{% endif %}
{% endfor %}
{% endif %}
{% if oc.telegram_group_bindings is defined %}
{% for gb in oc.telegram_group_bindings %}
{% if gb.account in acc_ns.active and gb.group_id | default('') | length > 0 %}{% if b_ns.rendered %},{% endif %}{% set b_ns.rendered = true %}
    {
      "agentId": "{{ gb.agent }}",
      "match": {
        "channel": "telegram",
        "accountId": "{{ gb.account }}",
        "peer": {
          "kind": "group",
          "id": "{{ gb.group_id }}"
        }
      }
    }
{% endif %}
{% endfor %}
{% endif %}  ]
{% endif %},
  "memory": {
    "backend": "qmd"
  },
  "plugins": {
    "entries": {
{% if oc_websearch_api_key | default('') | length > 0 %}      "perplexity": {
        "enabled": true,
        "config": {
          "webSearch": {
{# #126 (oc4): Web-Search-Key als SecretRef "${ENV}" statt Plaintext (Muster wie Provider-Keys,
   oc.secrets_ref; belegt: reference/secretref-credential-surface.md,
   plugins.entries.perplexity.config.webSearch.apiKey). OpenRouter-Umstellung (Betreiber-Entscheidung 2026-08-13):
   ein OpenRouter-Key (Praefix sk-or-) schaltet den Perplexity-Provider auf den
   OpenRouter-Chat-Completions-Pfad um (docs/tools/perplexity-search.md „OpenRouter/Sonar“);
   baseUrl/model optional explizit (Determinismus K2). #}
            "apiKey": "{{ '${' ~ oc.websearch_api_key_env ~ '}' if (oc.secrets_ref | default(false) | bool) else oc_websearch_api_key }}"
{% if oc.websearch_base_url | default('') | length > 0 %},
            "baseUrl": "{{ oc.websearch_base_url }}"
{% endif %}{% if oc.websearch_model | default('') | length > 0 %},
            "model": "{{ oc.websearch_model }}"
{% endif %}
          }
        }
      }
{% else %}      "perplexity": {
        "enabled": false
      }
{% endif %}    }
  },
  "tools": {
    "web": {
      "search": {
{% if oc_websearch_api_key | default('') | length > 0 %}        "provider": "perplexity"
{% else %}        "provider": "none"
{% endif %}      }
    }
{% if subagents_deny %},
    "subagents": {
      "tools": {
        "deny": {{ subagents_deny | tojson }}
      }
    }
{% endif %}
  },
  "models": {
    "providers": {
{% set ns = namespace(first=true) %}
{% for pname, penv in openclaw_provider_envs.items() %}
{% set pkey = lookup('env', penv) | default('', true) if penv else '' %}
{% if (pkey | length > 0) or (pname == 'ollama') %}
{% set pm = openclaw_provider_models[pname] %}
{% if not ns.first %},{% endif %}{% set ns.first = false %}
      "{{ pname }}": {
        "api": "{{ pm.api }}"
{% if pkey | length > 0 %},
        "apiKey": "{{ '${' ~ penv ~ '}' if (oc.secrets_ref | default(false) | bool) else pkey }}"
{% endif %}
{% if pm.baseUrl is defined and pm.baseUrl %},
        "baseUrl": "{{ pm.baseUrl }}"
{% endif %}
{% if pm.models is defined %},
        "models": {{ pm.models | tojson }}
{% endif %}
      }
{% endif %}
{% endfor %}
    }
  },
  "channels": {
    "telegram": {
{% if acc_ns.active | length > 0 %}
      "enabled": true,
      "defaultAccount": "{{ acc_ns.active[0] }}",
      "dmPolicy": "pairing",
      "accounts": {
{# #126 (S4): Bot-Token je Person als SecretRef "${ENV}" (Kurzform) – belegt:
   reference/secretref-credential-surface.md: channels.telegram.accounts.*.botToken.
   Aufloesung aus der Container-Umgebung (docker-compose.yml.j2 reicht die Tokens durch). #}
{% for acc_id in acc_ns.active %}        "{{ acc_id }}": {
          "botToken": "{{ '${' ~ oc.telegram_accounts[acc_id] ~ '}' }}"
        }{{ "," if not loop.last else "" }}
{% endfor %}      }
{# #126/S6: Gruppen-Allowlist + requireMention (oc4 – Harald 2026-09-06: ohne @ chatten).
   Nur im Multi-Account-Zweig gerendert (Komma-Sicherheit). #}
{% if oc.telegram_group_allow is defined and oc.telegram_group_allow | length > 0 %},
      "groupPolicy": "allowlist",
      "groups": {
{% for g in oc.telegram_group_allow %}        "{{ g.id }}": {
          "requireMention": {{ (g.require_mention | default(false)) | tojson }}
        }{{ "," if not loop.last else "" }}
{% endfor %}      }
{% endif %}
{% if oc.telegram_allow_from is defined and oc.telegram_allow_from | length > 0 %},
      "allowFrom": {{ oc.telegram_allow_from | tojson }}
{% endif %}
{% elif oc_telegram_bot_token | default('') | length > 0 %}
      "enabled": true,
      "botToken": "{{ oc_telegram_bot_token }}"
{% else %}
      "enabled": false
{% endif %}
    }
  }
}
