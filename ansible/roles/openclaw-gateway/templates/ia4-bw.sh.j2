#!/bin/sh
# ia4-bw – Bitwarden-CLI fuer den Agenten-Tresor (ADR-027, Issue #192).
# Von Ansible gerendert, read-only in den Container gemountet (nicht vom Agenten aenderbar).
# Liegt bewusst NICHT auf dem PATH: Aufrufe fragt das Plugin ia4-vault-approval in Telegram ab
# (Suche fragt und zeigt nur ID/Name, eine Lese-Freigabe gilt 10 Min. fuer einen Eintrag, ADR-027). Meldet sich selbst an, entsperrt,
# synchronisiert und reicht alle Argumente an das offizielle `bw` weiter.
# create/edit: reines JSON auf stdin wird vorher kodiert (wie `bw encode`).
set -eu

BW="{{ openclaw_bitwarden_prefix }}/bin/bw"
SERVER="{{ openclaw_bitwarden_server }}"

if [ -z "${BW_CLIENTID:-}" ] || [ -z "${BW_CLIENTSECRET:-}" ] || [ -z "${BW_PASSWORD:-}" ]; then
  echo "ia4-bw: Agenten-Tresor ist auf dieser Instanz nicht eingerichtet." >&2
  exit 2
fi
[ -x "$BW" ] || { echo "ia4-bw: Bitwarden CLI fehlt ($BW)." >&2; exit 2; }

if "$BW" status 2>/dev/null | grep -q '"status":"unauthenticated"'; then
  "$BW" config server "$SERVER" >/dev/null
  "$BW" login --apikey >/dev/null
fi
BW_SESSION=$("$BW" unlock --passwordenv BW_PASSWORD --raw)
export BW_SESSION
"$BW" sync >/dev/null

# Fuehrende Optionen (z. B. --pretty list items) umgingen den Namensfilter; serve (lokale REST-API
# mit entsperrtem Tresor) und export (ganzer Tresor) sind nicht vorgesehen (Review 2026-10-11).
case "${1:-}" in
  -*|serve|export) echo "ia4-bw: '${1}' ist nicht erlaubt (Befehl zuerst, ohne serve/export)." >&2; exit 2 ;;
esac

case "${1:-}" in
  create|edit|delete|restore|move) _write=1 ;;
  *) _write=0 ;;
esac

set +e
if { [ "${1:-}" = "create" ] && [ $# -eq 2 ]; } || { [ "${1:-}" = "edit" ] && [ $# -eq 3 ]; }; then
  if [ ! -t 0 ]; then
    _data=$(cat)
    case "$_data" in
      \{*|\[*) printf '%s' "$_data" | "$BW" encode | "$BW" "$@" ;;
      *) printf '%s' "$_data" | "$BW" "$@" ;;
    esac
  else
    "$BW" "$@"
  fi
  _rc=$?
elif [ "${1:-}" = "list" ] && [ "${2:-}" = "items" ]; then
  # Suche liefert nur ID und Name (keine Benutzernamen, URLs, Passwoerter); Freigabe je Suche
  # und je "get" fragt das Plugin ia4-vault-approval ab (ADR-027).
  _out=$("$BW" "$@")
  _rc=$?
  if [ "$_rc" -eq 0 ]; then
    printf '%s' "$_out" | node -e '
      let d = "";
      process.stdin.on("data", (c) => (d += c)).on("end", () => {
        let a;
        try {
          a = JSON.parse(d || "[]");
        } catch {
          console.error("ia4-bw: Suchergebnis nicht lesbar.");
          process.exit(1);
        }
        const items = Array.isArray(a) ? a : [];
        console.log(JSON.stringify(items.map((i) => ({ id: i.id, name: i.name }))));
      });'
    _rc=$?
  fi
else
  "$BW" "$@"
  _rc=$?
fi
set -e

# Sync-Fehler nach erfolgreichem Schreiben darf den Erfolg nicht verdecken (sonst Doppel-Eintrag
# durch erneuten Versuch des Agenten).
if [ "$_write" -eq 1 ]; then "$BW" sync >/dev/null 2>&1 || true; fi
exit "$_rc"
