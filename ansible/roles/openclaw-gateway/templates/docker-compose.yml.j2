{# Google-Drive-MCP (Token-Hygiene 2026-10-05): openclaw.json referenziert nur noch
   ${GDRIVE_*}; die Werte werden hier als Container-Env bereitgestellt, damit die
   Env-Substitution beim Gateway-Config-Load greift. Gate identisch zu openclaw.json.j2
   (_gdrive_ready): ohne Werte -> kein Env und dort enabled:false (kein MissingEnvVarError).
   Quelle bleibt ausschliesslich die GH-Secret-Kette (Workflow 04 -> lookup('env')). #}
{% set _gdrive_ready = (openclaw_gdrive_client_id | default('', true) | length > 0)
                       and (openclaw_gdrive_client_secret | default('', true) | length > 0)
                       and (openclaw_gdrive_refresh_token | default('', true) | length > 0)
                       and (openclaw_gdrive_access_token | default('', true) | length > 0) %}
# OpenClaw-Gateway {{ oc.name }} (ADR-025 revidiert) – gepinnt, localhost-only, traefik-network
services:
  openclaw:
    image: {{ openclaw_image }}:{{ openclaw_image_version }}
    container_name: openclaw-{{ oc.name }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ oc.port }}:{{ oc.port }}"
    environment:
      OPENCLAW_GATEWAY_TOKEN: "{{ oc_gateway_token | default('') }}"
      # K4-3 (PR #83): deaktiviert exec-Startup-Snapshot, der Secret-Variablen ausschliesst
      # (docs/tools/exec.md Z.74: "Set OPENCLAW_EXEC_SHELL_SNAPSHOT=0 ... to disable this snapshot path")
      OPENCLAW_EXEC_SHELL_SNAPSHOT: "0"
      # K3-3 (PR #83): GH-Read-Token ZWEI Wege, bewusst:
      #  1) GH_TOKEN-Env -> gh-CLI im Container nutzt Token nativ (gh liest GH_TOKEN automatisch)
      #  2) .gh-read-token-Datei (instance.yml) -> Agents lesen Token via read (Pilot-Prompt-Pfad,
      #     QMD indiziert hidden paths nicht -> kein Memory-Index-Leak)
{% if oc_gh_token | default('') | length > 0 %}
      GH_TOKEN: "{{ oc_gh_token }}"
{% endif %}
{% if oc_bitwarden_clientscurect | default('') | length > 0 %}
      BITWARDEN_CLIENTSECRET: "{{ oc_bitwarden_clientscurect }}"
{% endif %}
{# Google-Drive-MCP: Ref-Ziel fuer openclaw.json ${GDRIVE_*}; ein gemeinsames Konto nur fuer OCs. #}
{% if _gdrive_ready %}
      GDRIVE_CLIENT_ID: "{{ openclaw_gdrive_client_id }}"
      GDRIVE_CLIENT_SECRET: "{{ openclaw_gdrive_client_secret }}"
      GDRIVE_REFRESH_TOKEN: "{{ openclaw_gdrive_refresh_token }}"
      GDRIVE_ACCESS_TOKEN: "{{ openclaw_gdrive_access_token }}"
{% endif %}
      OPENCLAW_WORKSPACE_DIR: "/home/node/.openclaw/workspace"
      PATH: "/home/node/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
{% if oc_telegram_bot_token | default('') | length > 0 %}
      TELEGRAM_BOT_TOKEN: "{{ oc_telegram_bot_token }}"
{% endif %}
    volumes:
      - ./config:/home/node/.openclaw
      - ./workspace:/home/node/.openclaw/workspace
    networks:
      - {{ docker_network }}

networks:
  {{ docker_network }}:
    external: true
