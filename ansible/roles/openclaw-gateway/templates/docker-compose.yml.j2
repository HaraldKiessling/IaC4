# OpenClaw-Gateway {{ oc.name }} (ADR-025 revidiert) – gepinnt, localhost-only, traefik-network
services:
  openclaw:
    image: {{ openclaw_image }}:{{ openclaw_image_version }}
    container_name: openclaw-{{ oc.name }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ oc.port }}:{{ oc.port }}"   # loopback-only Exposition (ADR-025); TLS-Front = tailscale serve (Konzept §3 (a))
    environment:
      OPENCLAW_GATEWAY_TOKEN: "{{ oc_gateway_token | default('') }}"
      # K4-3 (PR #83): deaktiviert exec-Startup-Snapshot, der Secret-Variablen ausschliesst
      # (docs/tools/exec.md Z.74: "Set OPENCLAW_EXEC_SHELL_SNAPSHOT=0 ... to disable this snapshot path")
      OPENCLAW_EXEC_SHELL_SNAPSHOT: "0"
      # K3-3 (PR #83): GH-Read-Token ZWEI Wege, bewusst:
      #  1) GH_TOKEN-Env -> gh-CLI im Container nutzt Token nativ (gh liest GH_TOKEN automatisch)
      #  2) .gh-read-token-Datei (instance.yml) -> Agents lesen Token via read (Pilot-Prompt-Pfad,
      #     QMD indiziert hidden paths nicht -> kein Memory-Index-Leak)
{% if oc_gh_token | default('') | length > 0 %}
      GH_TOKEN: "{{ oc_gh_token }}"
{% endif %}
      OPENCLAW_WORKSPACE_DIR: "/home/node/.openclaw/workspace"
      PATH: "/home/node/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
{% if oc_telegram_bot_token | default('') | length > 0 %}
      TELEGRAM_BOT_TOKEN: "{{ oc_telegram_bot_token }}"
{% endif %}
{% if oc.secrets_ref | default(false) | bool %}
      # #126 Pilot (oc4): Geteilte Provider-Keys als Container-Env – SecretRef-Aufloesung im
      # Gateway-Prozess (openclaw.json enthaelt nur "${ENV}"; Werte aus GH-Secrets via Workflow 04).
{% for pname, penv in openclaw_provider_envs.items() %}
{% set pkey = lookup('env', penv) | default('', true) if penv else '' %}
{% if pkey | length > 0 %}
      {{ penv }}: "{{ pkey }}"
{% endif %}
{% endfor %}
{% if oc.websearch_api_key_env is defined and oc.websearch_api_key_env | length > 0 %}
{% set ws_key = lookup('env', oc.websearch_api_key_env) | default('', true) %}
{% if ws_key | length > 0 %}
      {{ oc.websearch_api_key_env }}: "{{ ws_key }}"   # #126 (oc4): Web-Search-Key als Container-Env – SecretRef-Aufloesung im Gateway-Prozess (openclaw.json: plugins.entries.perplexity.config.webSearch.apiKey)
{% endif %}
{% endif %}
{% endif %}
{% if oc.telegram_accounts is defined and oc.telegram_accounts | length > 0 %}
      # #126 Pilot (oc4): Telegram-Bot-Token je Person (SecretRef "${ENV}" in openclaw.json).
{% for acc_id, acc_env in oc.telegram_accounts.items() %}
{% set acc_tok = lookup('env', acc_env) | default('', true) %}
{% if acc_tok | length > 0 %}
      {{ acc_env }}: "{{ acc_tok }}"
{% endif %}
{% endfor %}
{% endif %}
    volumes:
      - ./config:/home/node/.openclaw
      - ./workspace:/home/node/.openclaw/workspace
    networks:
      - {{ docker_network }}

networks:
  {{ docker_network }}:
    external: true
