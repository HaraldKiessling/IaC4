services:
  qdrant:
    image: qdrant/qdrant:{{ qdrant_version }}
    container_name: qdrant
    restart: unless-stopped
    # Host-Publish NUR auf Loopback (Befund 2026-11-22, Prod): tailscaled haelt
    # 100.77.47.98%tailscale0:6333/6334 (Tailscale Serve -> localhost:6333/6334).
    # Ein Publish auf 0.0.0.0:6333 kollidiert damit ("address already in use") und
    # bricht den Service-Deploy ab. 127.0.0.1 ist frei, Serve proxyt unveraendert
    # auf https://<host>.<tailnet>.ts.net:6333 -> 127.0.0.1:6333.
    # Zusaetzlich: keine Exposition auf oeffentlichen Interfaces (ADR-018).
    ports:
      - "127.0.0.1:6333:6333"
      - "127.0.0.1:6334:6334"
    volumes:
      - qdrant-data:/qdrant/storage
      - ./config.yaml:/qdrant/config/production.yaml:ro
    networks:
      - {{ docker_network }}

volumes:
  qdrant-data:

networks:
  {{ docker_network }}:
    external: true
