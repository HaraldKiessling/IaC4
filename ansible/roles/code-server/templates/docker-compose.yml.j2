# Code-Server docker-compose (Issue #65)
# ADR-017: Image gepinnt via code_server_version (kein latest)
# ADR-018: kein ACME/443 – TLS-Terminierung durch Tailscale Serve (TS-TLS, Root-Mount -> :80)
# R2: Router Host(<fqdn>) && PathPrefix(/code) + stripprefix /code + priority=100 (IaC3-Muster)
# Kein docker.sock, keine API-Key-Envs, kein Host-Port-Publish (8443 nur intern im traefik-network)
services:
  code-server:
    image: lscr.io/linuxserver/code-server:{{ code_server_version }}
    container_name: code-server
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Berlin
      - PASSWORD={{ code_server_password }}
      - SUDO_PASSWORD={{ code_server_sudo_password }}
      - DEFAULT_WORKSPACE=/workspace
    volumes:
      - code-server-data:/config
      - /workspace:/workspace
    networks:
      - {{ docker_network }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.code-server.rule=Host(`{{ code_server_hostname }}`) && PathPrefix(`/code`)"
      - "traefik.http.routers.code-server.priority=100"
      - "traefik.http.middlewares.code-server-stripprefix.stripprefix.prefixes=/code"
      - "traefik.http.routers.code-server.middlewares=code-server-stripprefix"
      - "traefik.http.services.code-server.loadbalancer.server.port=8443"

volumes:
  code-server-data:

networks:
  {{ docker_network }}:
    external: true
