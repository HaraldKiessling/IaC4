# Traefik Static Config (ADR-018: HTTP-only, kein ACME; ADR-019: Dashboard ohne insecure; ADR-020: accessLog JSON → stdout)
api:
  dashboard: true
  debug: false

entryPoints:
  web:
    address: ":80"
  dashboard:
    address: ":8080"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: {{ docker_network }}
    watch: true
  file:
    directory: /etc/traefik/config
    watch: true

accessLog:
  format: json
  fields:
    defaultMode: keep
    names:
      ClientAddr: drop
      ClientHost: drop

log:
  level: INFO
