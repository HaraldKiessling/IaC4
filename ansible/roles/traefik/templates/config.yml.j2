# Traefik Dynamic Config (ADR-019): Dashboard nur via EntryPoint :8080.
# Schutz: UFW-Regel R8 (8080 nur aus 100.64.0.0/10) + Tailscale Serve (tailnet only) + DOCKER-USER.
# KEINE ipAllowList-Middleware: Traefik-v3-Bug blockt 127.0.0.1 trotz sourceRange
# (https://github.com/traefik/traefik/issues/10653) – Serve verbindet selbst von 127.0.0.1
# -> jeder Nutzer bekäme 403. IaC3-Verhalten: Schutz rein über Tailnet/Firewall.
http:
  routers:
    dashboard:
      rule: "PathPrefix(`/api`) || PathPrefix(`/dashboard`)"
      entryPoints:
        - dashboard
      service: api@internal
