# Traefik Dynamic Config (ADR-019): Dashboard nur via EntryPoint :8080 + BasicAuth.
# Credentials aus GH-Secret TRAEFIK_DASHBOARD_AUTH ("user:<bcrypt-hash>"), nie im Repo.
http:
  routers:
    dashboard:
      rule: "PathPrefix(`/api`) || PathPrefix(`/dashboard`)"
      entryPoints:
        - dashboard
      service: api@internal
      middlewares:
        - dashboard-auth

  middlewares:
    dashboard-auth:
      basicAuth:
        users:
          - "{{ traefik_dashboard_auth }}"
