# Traefik Dynamic Config (ADR-019): Dashboard nur via EntryPoint :8080.
# Auth: IP-Allowlist (Tailscale-CGNAT) – IaC3-Muster (auth-tailscale-only),
# kein Passwort (Nutzbarkeit im Browser; Schutz = Tailnet). BasicAuth bei Bedarf reaktivierbar.
http:
  routers:
    dashboard:
      rule: "PathPrefix(`/api`) || PathPrefix(`/dashboard`)"
      entryPoints:
        - dashboard
      service: api@internal
      middlewares:
        - auth-tailscale-only

  middlewares:
    auth-tailscale-only:
      ipAllowList:
        sourceRange:
          - "100.64.0.0/10"
