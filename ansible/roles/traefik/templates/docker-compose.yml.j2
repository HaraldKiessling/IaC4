# Traefik docker-compose (ADR-017: Image gepinnt; ADR-018: nur Port 80 + Dashboard 8080, kein 443/ACME; ADR-020: json-file-Rotation)
services:
  traefik:
    image: traefik:{{ traefik_version }}
    container_name: traefik
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    ports:
      - "0.0.0.0:80:80"
      - "0.0.0.0:8080:8080"
    networks:
      - {{ docker_network }}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/traefik.yml:ro
      - ./config:/etc/traefik/config:ro
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  {{ docker_network }}:
    external: true
