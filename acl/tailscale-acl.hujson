{
  // ===========================================================================
  // Tailscale-ACL — Single Source of Truth (SSoT) für das gesamte Tailnet
  //
  // Verwaltet ausschließlich in IaC4 (Owner-Entscheid 2026-09-11: "Tailscale-ACL
  // ist Infrastruktur und gehört zu IaC4"). Diese Datei ist die EINE Regelquelle
  // für BEIDE Tag-Welten:
  //   - tag:ia3 / tag:ia4 / tag:ci  (IaC4-/IaC3-Welt)
  //   - tag:ha / tag:ha-ci          (HA-Welt, vormals ha-repo)
  //
  // Konventionen (siehe acl/README.md):
  //   1. Feste Reihenfolge der Blöcke: tagOwners → acls → ssh.
  //      tagOwners VOR acls/ssh ist zwingend (acls/ssh referenzieren die Tags).
  //   2. Jeder Eintrag trägt genau eine Marker-Zeile unmittelbar darüber:
  //        // rule: <gruppe> [pending]   → Regel einer (Teil-)Menge; insertierbar
  //                                        bei selektivem Apply über --rule <gruppe>
  //        // base                       → Bestands-Eintrag (pre-IaC4/Owner-Konsole);
  //                                        NIE eingefügt, nur erwartet/verifiziert
  //      `pending` = deklariert, aber NICHT Teil des aktuellen Live-Solls
  //      (eigene, noch ausstehende Owner-Freigabe). Pending-Einträge werden bei
  //      einem Apply NUR berücksichtigt, wenn die Gruppe explizit selektiert wird.
  //   3. Kommentare sind huJSON-Kommentare (// oder /* */); Trailing-Kommas sind
  //      erlaubt. `scripts/ensure-acl.py` parst die Datei semantisch (huJSON→JSON).
  //
  // Live-Bezug (Stand 2026-09-11, aus Run-Logs rekonstruiert):
  //   live = base + iac4 + ha-tagowners + ha-acl + mqtt-1883 + ha-runner
  //          + owner-8123 + ha-ssh   (HA-Regeln 1–6; Regel 7 pending/nicht live)
  //   Der Live-Bestand ist derzeit eine Run-Log-Rekonstruktion – KEIN roher
  //   huJSON-Export vorhanden (Governance-Lücke V2, siehe Runbook). Nach Schließen
  //   der Lücke durch den rohen Export + `--verify` zu ersetzen/bestätigen.
  //   Die IaC4-Gewähr endet am 31.07.2026 (API-Key seither 401).
  // ===========================================================================

  "tagOwners": {
    // base — IaC3-Bestand (nicht von IaC4 erzeugt; dient als Einfüge-Anker)
    "tag:ia3": ["autogroup:admin"],

    // rule: iac4 — IaC4-VPS-Ziel-Tag
    "tag:ia4": ["autogroup:admin"],

    // base — Bestand (pre-IaC4/Owner-Konsole; Wert per Live-GET zu bestätigen)
    "tag:ci": ["autogroup:admin"],

    // rule: ha-tagowners — HA-Regel 1: tag:ha (Knoten ha1/ha3) + Runner-Tag
    // tag:ha-ci. Beide live (Owner-Go #1293/#1364; Apply #34041926673).
    "tag:ha": ["autogroup:owner"],
    "tag:ha-ci": ["autogroup:owner"],
  },

  "acls": [
    // base — IaC3-Bestand: ci/member/admin → tag:ia3
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
      "dst": ["tag:ia3:*"],
    },

    // rule: iac4 — IaC4 Option A: CI/User → ia4 + ia4 intern (live, Apply 31.07.)
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
      "dst": ["tag:ia4:*"],
    },
    {
      "action": "accept",
      "src": ["tag:ia4"],
      "dst": ["tag:ia4:*"],
    },

    // rule: ha-acl — HA-Regel 2: oc/vps-dev (tag:ia4) + CI (tag:ci) + Owner →
    // ha1/ha3 (tag:ha), LESEND: NUR Ports 22 + 8123. Live (Apply #34059798052).
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci", "tag:ia4"],
      "dst": ["tag:ha:22", "tag:ha:8123"],
    },

    // rule: mqtt-1883 — HA-Regel 6 (MQTT 1883): vps-dev (tag:ia4) →
    // ha1/ha3 (tag:ha), LESEND: NUR Port 1883 (core-mosquitto).
    // ✅ LIVE-SOLL (belegt 2026-09-11, Run-Log-Rekonstruktion): additiver POST
    //    am 2026-09-09T19:59:30Z, HA-Repo-Run 34398338512 mit DRY_RUN=false →
    //    Log "➕ …1883 MQTT eingefügt", "✅ count==1", kein Rollback.
    //    Widerspruch aufgelöst: der kursierende "20:02Z-Apply" war KEIN Apply –
    //    Run 34398400415 (2026-09-09T20:00Z) lief mit DRY_RUN=true. Der Live-Bestand
    //    stammt derzeit aus Run-Logs (kein roher Export, Lücke V2); nach Schließen
    //    der Lücke mit rohem Export + `--verify` bestätigen.
    {
      "action": "accept",
      "src": ["tag:ia4"],
      "dst": ["tag:ha:1883"],
    },

    // rule: ha-runner — HA-Regel 4: HA-Runner (tag:ha-ci) → tag:ia4 (vps-dev),
    // NUR 22 + 8123. Live (Apply #34041926673).
    {
      "action": "accept",
      "src": ["tag:ha-ci"],
      "dst": ["tag:ia4:22", "tag:ia4:8123"],
    },

    // rule: owner-8123 — HA-Regel 5: Owner/Admin → tag:ia4:8123 (HA-Staging-
    // Web-UI/API). Live (Apply #34049070143). src-Form vor Apply per GET bestätigen.
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member"],
      "dst": ["tag:ia4:8123"],
    },

    // rule: console-owner — Owner-Konsolen-Cluster (Regel-1-Gruppe „Du zu HA
    // & HA zu Dir"): owner ↔ tag:ha + Zugriff ins LAN. Aus der Admin-Konsole
    // stammend (pre-IaC4-Fremdbestand), Owner-Entscheid 2026-09-11 (19:52 UTC):
    // „Ja" – die vier Einträge werden INS MODELL übernommen und sind damit
    // künftig modellverwaltet (verwalteter Bestand, nicht mehr Fremdbestand).
    // Reihenfolge = echte Live-Position (zwischen owner-8123 und der IaC3-Welt).
    // AUSDRÜCKLICH GEWOLLT: `owner → 192.168.2.0/24:*` (zweites Heimnetz) bleibt
    // bestehen – eine spätere Entfernung wäre eine eigene, bewusste Änderung.
    {
      "action": "accept",
      "src": ["autogroup:owner"],
      "dst": ["tag:ha:*"],
    },
    {
      "action": "accept",
      "src": ["autogroup:owner"],
      "dst": ["192.168.0.0/24:*"],
    },
    {
      "action": "accept",
      "src": ["autogroup:owner"],
      "dst": ["192.168.2.0/24:*"],
    },
    {
      "action": "accept",
      "src": ["tag:ha"],
      "dst": ["autogroup:owner:*"],
    },

    // rule: energie-read pending — HA-Regel 7 (Energie-Lesezugriff, Owner-
    // Entscheide D1–D4 2026-09-11): BEIDE VPS (tag:ia4) → genau drei Ziele,
    // NUR LESEND (kein Schreib-Block). NICHT live – eigene Freigabe ausstehend.
    {
      "action": "accept",
      "src": ["tag:ia4"],
      "dst": ["192.168.0.31:1502", "192.168.0.13:80", "192.168.0.13:1502"],
    },
  ],

  "ssh": [
    // rule: iac4 — IaC4: ci/member/admin → tag:ia4 (live, Apply 31.07.)
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
      "dst": ["tag:ia4"],
      "users": ["deploy-user", "root", "ubuntu"],
    },

    // rule: ha-ssh — HA-Regel 3: Spiegel des IaC4-Musters → tag:ha (ha1/ha3).
    // Live (Apply #34059798052). F11: users-Mapping ist IaC4-Spiegel, kein
    // verifizierter Ist-Zustand der HA-Knoten (vor Nutzung gegenprüfen).
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
      "dst": ["tag:ha"],
      "users": ["deploy-user", "root", "ubuntu"],
    },
  ],
}
