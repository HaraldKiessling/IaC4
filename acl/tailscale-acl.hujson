{
  // ===========================================================================
  // Tailscale-ACL — Single Source of Truth (SSoT) für das gesamte Tailnet
  //
  // Verwaltet ausschließlich in IaC4 (Owner-Entscheid 2026-09-11: "Tailscale-ACL
  // ist Infrastruktur und gehört zu IaC4"). Diese Datei ist die EINE Regelquelle
  // für BEIDE Tag-Welten:
  //   - tag:ia3 / tag:ia4 / tag:ci  (IaC4-/IaC3-Welt)
  //   - tag:ha / tag:ha-ci          (HA-Welt, vormals ha-repo)
  //
  // Konventionen (siehe acl/README.md):
  //   1. Feste Reihenfolge der Blöcke: tagOwners → acls → ssh.
  //      tagOwners VOR acls/ssh ist zwingend (acls/ssh referenzieren die Tags).
  //   2. Jeder Eintrag trägt genau eine Marker-Zeile unmittelbar darüber:
  //        // rule: <gruppe> [pending]   → Regel einer (Teil-)Menge; insertierbar
  //                                        bei selektivem Apply über --rule <gruppe>
  //        // base                       → Bestands-Eintrag (pre-IaC4/Owner-Konsole);
  //                                        NIE eingefügt, nur erwartet/verifiziert
  //      `pending` = deklariert, aber NICHT Teil des aktuellen Live-Solls
  //      (eigene, noch ausstehende Owner-Freigabe). Pending-Einträge werden bei
  //      einem Apply NUR berücksichtigt, wenn die Gruppe explizit selektiert wird.
  //   3. Kommentare sind huJSON-Kommentare (// oder /* */); Trailing-Kommas sind
  //      erlaubt. `scripts/ensure-acl.py` parst die Datei semantisch (huJSON→JSON).
  //
  // Live-Bezug (Stand 2026-09-23, roher POST-APPLY-Live-Export):
  //   live = base + iac4 + ha-tagowners + ha-acl + mqtt-1883 + ha-runner
  //          + owner-8123 + console-owner + ha-ssh + energie-read
  //          + ksem-read + goe-read + shelly-read
  //   pending (deklariert, NICHT Teil des Live-Solls): — (derzeit KEINE)
  //          (goe-read wurde am 2026-09-23 live angewendet und ist damit managed;
  //           seit 2026-09-16 ist ksem-read managed; shelly-read wurde am
  //           2026-09-20 live angewendet und ist damit ebenfalls managed, s. u.)
  //          (HA-Regeln 1–7; energie-read aktiviert: Owner-Go 2026-09-11 21:57 UTC;
  //           ksem-port-probe aktiviert: Owner-Go 2026-09-12 12:41 UTC –
  //           am 2026-09-16 04:28 UTC 1:1 durch ksem-read substituiert;
  //           shelly-read aktiviert: Owner-Go 2026-09-20, Apply Run 35519859126;
  //           goe-read aktiviert: Owner-Go 2026-09-23, Apply Run 35847592020)
  //   Anker: roher Live-Export acl-live-export-20260923T101428Z.hujson
  //   (sha256 31fb6d91…d8e6, 2026-09-23T10:14:28Z, Run 35847628450 – POST-APPLY
  //   nach goe-read). `--verify --tolerated-foreign` gegen diesen Export
  //   ist grün (exit 0). Der rohe Export wird NICHT versioniert (.gitignore;
  //   Kopie im Workspace; siehe acl/README.md + Runbook). V1/V2 (Key, Roh-Export)
  //   sind damit geschlossen.
  //   Die IaC4-Gewähr endet am 31.07.2026 (seither kein IaC4-Apply bis 2026-09-11).
  // ===========================================================================

  "tagOwners": {
    // base — IaC3-Bestand (nicht von IaC4 erzeugt; dient als Einfüge-Anker)
    "tag:ia3": ["autogroup:admin"],

    // rule: iac4 — IaC4-VPS-Ziel-Tag
    "tag:ia4": ["autogroup:admin"],

    // base — Bestand (pre-IaC4/Owner-Konsole; Wert per Live-GET zu bestätigen)
    "tag:ci": ["autogroup:admin"],

    // rule: ha-tagowners — HA-Regel 1: tag:ha (Knoten ha1/ha3) + Runner-Tag
    // tag:ha-ci. Beide live (Owner-Go #1293/#1364; Apply #34041926673).
    "tag:ha": ["autogroup:owner"],
    "tag:ha-ci": ["autogroup:owner"],
  },

  "acls": [
    // base — IaC3-Bestand: ci/member/admin → tag:ia3
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
      "dst": ["tag:ia3:*"],
    },

    // rule: iac4 — IaC4 Option A: CI/User → ia4 + ia4 intern (live, Apply 31.07.)
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
      "dst": ["tag:ia4:*"],
    },
    {
      "action": "accept",
      "src": ["tag:ia4"],
      "dst": ["tag:ia4:*"],
    },

    // rule: ha-acl — HA-Regel 2: oc/vps-dev (tag:ia4) + CI (tag:ci) + Owner →
    // ha1/ha3 (tag:ha), LESEND: NUR Ports 22 + 8123. Live (Apply #34059798052).
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci", "tag:ia4"],
      "dst": ["tag:ha:22", "tag:ha:8123"],
    },

    // rule: mqtt-1883 — HA-Regel 6 (MQTT 1883): vps-dev (tag:ia4) →
    // ha1/ha3 (tag:ha), LESEND: NUR Port 1883 (core-mosquitto).
    // ✅ LIVE-SOLL (belegt 2026-09-11, Run-Log-Rekonstruktion): additiver POST
    //    am 2026-09-09T19:59:30Z, HA-Repo-Run 34398338512 mit DRY_RUN=false →
    //    Log "➕ …1883 MQTT eingefügt", "✅ count==1", kein Rollback.
    //    Widerspruch aufgelöst: der kursierende "20:02Z-Apply" war KEIN Apply –
    //    Run 34398400415 (2026-09-09T20:00Z) lief mit DRY_RUN=true. Der Live-Bestand
    //    stammt derzeit aus Run-Logs (kein roher Export, Lücke V2); nach Schließen
    //    der Lücke mit rohem Export + `--verify` bestätigen.
    {
      "action": "accept",
      "src": ["tag:ia4"],
      "dst": ["tag:ha:1883"],
    },

    // rule: ha-runner — HA-Regel 4: HA-Runner (tag:ha-ci) → tag:ia4 (vps-dev),
    // NUR 22 + 8123. Live (Apply #34041926673).
    {
      "action": "accept",
      "src": ["tag:ha-ci"],
      "dst": ["tag:ia4:22", "tag:ia4:8123"],
    },

    // rule: owner-8123 — HA-Regel 5: Owner/Admin → tag:ia4:8123 (HA-Staging-
    // Web-UI/API). Live (Apply #34049070143). src-Form vor Apply per GET bestätigen.
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member"],
      "dst": ["tag:ia4:8123"],
    },

    // rule: console-owner — Owner-Konsolen-Cluster (Regel-1-Gruppe „Du zu HA
    // & HA zu Dir"): owner ↔ tag:ha + Zugriff ins LAN. Aus der Admin-Konsole
    // stammend (pre-IaC4-Fremdbestand), Owner-Entscheid 2026-09-11 (19:52 UTC):
    // „Ja" – die vier Einträge werden INS MODELL übernommen und sind damit
    // künftig modellverwaltet (verwalteter Bestand, nicht mehr Fremdbestand).
    // Reihenfolge = echte Live-Position (zwischen owner-8123 und der IaC3-Welt).
    // AUSDRÜCKLICH GEWOLLT: `owner → 192.168.2.0/24:*` (zweites Heimnetz) bleibt
    // bestehen – eine spätere Entfernung wäre eine eigene, bewusste Änderung.
    {
      "action": "accept",
      "src": ["autogroup:owner"],
      "dst": ["tag:ha:*"],
    },
    {
      "action": "accept",
      "src": ["autogroup:owner"],
      "dst": ["192.168.0.0/24:*"],
    },
    {
      "action": "accept",
      "src": ["autogroup:owner"],
      "dst": ["192.168.2.0/24:*"],
    },
    {
      "action": "accept",
      "src": ["tag:ha"],
      "dst": ["autogroup:owner:*"],
    },

    // rule: energie-read — HA-Regel 7 (Energie-Lesezugriff, live-gewollt).
    // Owner-Go 2026-09-11 21:57 UTC: BEIDE VPS (tag:ia4) → genau drei Ziele,
    // NUR LESEND (kein Schreib-Block). Ziele: 192.168.0.31:1502 (KSEM/Bilanz,
    // Modbus TCP, slave 71), 192.168.0.13:80 (Kostal WR Plenticore REST),
    // 192.168.0.13:1502 (Kostal WR Modbus TCP). Aktivierung bereits geprüfter
    // Inhalte aus PR #140/#142 – keine neue Semantik.
    {
      "action": "accept",
      "src": ["tag:ia4"],
      "dst": ["192.168.0.31:1502", "192.168.0.13:80", "192.168.0.13:1502"],
    },

    // rule: ksem-read — DAUERHAFT (VORLAGE 2026-09-12; Owner-Go Inhalt 2026-09-15
    // 21:27, PORTUMFANG erweitert 2026-09-16 04:28; Substitution in EINEM Schritt
    // 2026-09-16, Review-Auflage PR #153):
    // tag:ia4 (BEIDE VPS) → KSEM 192.168.0.31 NUR LESEND auf :502 (Standard-Modbus
    // TCP; Diagnose 2026-09-12: FC3 Unit 71 OK, :1502 REFUSED) UND :80 (Web/Diagnose-
    // Identität). Portumfang = GENAU die zwei Ports der vormals temporären Diagnose-
    // Gruppe `ksem-port-probe` (:80+:502). Diese dauerhafte Lese-Regel löst die Probe
    // 1:1 ab; der Probe-Block wurde im selben Schritt aus dem Modell entfernt
    // (kein Doppelzustand, keine Live-Löschung – der Applier ist rein additiv und
    // die Live-Zeile entspricht exakt dieser Regel). NICHT die tote :1502.
    {
      "action": "accept",
      "src": ["tag:ia4"],
      "dst": ["192.168.0.31:80", "192.168.0.31:502"],
    },

    // rule: goe-read — GO-E CHARGER (nativ via LAN): tag:ia4 (BEIDE VPS) →
    // 192.168.0.56 auf GENAU zwei Ports: :80 (HTTP API v2 – GET /api/status) UND
    // :502 (Modbus TCP – FC3/FC4 lesend). Gedacht für Lese-/Statuswerte des Chargers.
    // Die ACL selbst ist accept-only; KEIN Schreib-Block, KEINE Subnetz-Öffnung.
    // ✅ LIVE-SOLL (Owner-Go 2026-09-23): additiver IaC4-Apply am 2026-09-23T10:13:59Z
    //    (00-acl-apply.yml Run 35847592020, rules=goe-read, dry_run=false,
    //    confirm=APPLY-ACL): "➕ [goe-read] eingefügt", Pre-POST-Guard rein additiv,
    //    acls count==1-Gate ✅, Additivität ✅, kein Rollback. ROLLBACK: diesen Block
    //    entfernen + Commit zurücknehmen — der Applier ist rein additiv und löscht
    //    nie, daher KEIN Live-POST zum Entfernen nötig.
    {
      "action": "accept",
      "src": ["tag:ia4"],
      "dst": ["192.168.0.56:80", "192.168.0.56:502"],
    },

    // rule: shelly-read — SHELLY (nativ via LAN): tag:ia4 (BEIDE VPS) →
    // die vier Shelly-IPs 192.168.0.26/.27/.63/.67 NUR auf :80 (lokale RPC-/HTTP-API).
    // Geräte (Gen2): .26 Plus1_01, .27 Plus1_02, .63 Pro EM, .67 Pro 3EM.
    // BEABSICHTIGT READ-ONLY: nur der lokale Lese-/Status-Port, KEINE Steuer-/Schreib-
    // Ports, KEINE Subnetz-Öffnung. Protokoll-Abgleich (Doku): Shelly Gen2 spricht RPC
    // über HTTP :80 (HA-Doku: Gen2 braucht keine Zusatzkonfiguration); CoAP/UDP :5683
    // betrifft NUR Gen1-CoIoT — hier (4× Gen2) NICHT nötig.
    // ✅ LIVE-SOLL (Owner-Go 2026-09-20): additiver IaC4-Apply am 2026-09-20T15:31:52Z
    //    (00-acl-apply.yml Run 35519859126, rules=shelly-read, dry_run=false,
    //    confirm=APPLY-ACL): "➕ [shelly-read] eingefügt", Pre-POST-Guard rein additiv,
    //    acls count==1-Gate ✅, Additivität ✅, kein Rollback. .63/.67 VOR dem Apply
    //    read-only gegen die live-Registry verifiziert (kein DHCP-Drift).
    {
      "action": "accept",
      "src": ["tag:ia4"],
      "dst": ["192.168.0.26:80", "192.168.0.27:80", "192.168.0.63:80", "192.168.0.67:80"],
    },
  ],

  "ssh": [
    // rule: iac4 — IaC4: ci/member/admin → tag:ia4 (live, Apply 31.07.)
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
      "dst": ["tag:ia4"],
      "users": ["deploy-user", "root", "ubuntu"],
    },

    // rule: ha-ssh — HA-Regel 3: Spiegel des IaC4-Musters → tag:ha (ha1/ha3).
    // Live (Apply #34059798052). F11: users-Mapping ist IaC4-Spiegel, kein
    // verifizierter Ist-Zustand der HA-Knoten (vor Nutzung gegenprüfen).
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
      "dst": ["tag:ha"],
      "users": ["deploy-user", "root", "ubuntu"],
    },
  ],
}
