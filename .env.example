# IaC4 – Secrets-Referenz
# Kopieren nach .env und ausfüllen.
# Alle Secrets werden via GH Actions Secrets verwaltet (nicht committen).

# --- GitHub ---
GH_TOKEN=***                           # PAT mit repo + workflow scope
GIT_BOT_EMAIL=***                        # Git-Committer (Workflow 00)

# --- VPS Zugang (für manuelle Tests) ---
VPS_USER=deploy-user
VPS_DEV_PUBLIC_IP=1.2.3.4          # Public-IP für Workflow 02 (Bootstrap)
VPS_PROD_PUBLIC_IP=1.2.3.4         # Public-IP für PROD-Bootstrap (Secret noch nicht gesetzt)
VPS_SSH_KEY_PATH=~/.ssh/id_ed25519 # private Key (GH Secret: SSH_KEY)

# --- Tailscale ---
TAILSCALE_TAILNET=tailcfea8a.ts.net
TAILSCALE_OAUTH_CLIENT_ID=xxx
TAILSCALE_OAUTH_CLIENT_SECRET=***
TAILSCALE_API_KEY=xxx                    # NUR Workflow 01 (Terraform-Provider, Bootstrap); 02/03/04 nutzen OAuth-Client-Token
TAILSCALE_HOSTNAME_DEV=vps-dev
TAILSCALE_HOSTNAME_PROD=vps-prod
# Hinweis: VPS_DEV_HOST/VPS_PROD_HOST sind NICHT mehr nötig —
# die Tailscale-IP wird zur Laufzeit per Tailscale-API aufgelöst (Workflow 02/03).

# --- Traefik (Let's Encrypt) ---

# --- Code-Server ---
CODE_SERVER_VERSION=4.131.0-ls354                 # Image-Pin (ADR-017); SSoT: ansible/group_vars/all.yml code_server_version (NICHT deploy-wirksam, rein informativ, K5-2)
CODE_SERVER_PASSWORD=changeme
CODE_SERVER_SUDO_PASSWORD=changeme
CODE_SERVER_HOSTNAME=vps-dev.tailcfea8a.ts.net    # DEV-MagicDNS-FQDN; Workflow 04 setzt CODE_SERVER_HOSTNAME automatisch (vps-<target>.<TAILSCALE_TAILNET>)

# --- OpenClaw ---
OPENCLAW_LLM_PROVIDER=anthropic            # oder openai, google
OPENCLAW_LLM_API_KEY=***
OPENCLAW_WEBSEARCH_API_KEY=***
OPENCLAW_GATEWAY_PORT=18789

# --- OpenClaw DEV-Instanz oc4 (Pilot Familien-Instanz, GH #126) ---
# Betreiber-Entscheidung 2026-08-13: Pilot auf NEUER Instanz oc4 (Port 18792); oc1/oc2/oc3 unangetastet.
# Geteilte LLM-Keys (Familien-Budget, S2) – SSoT: ansible/group_vars/vps-dev.yml openclaw_provider_envs
DEV_DEEPSEEK_API_KEY=***                     # DeepSeek API-Key (geteilt; GH-Secret DEV_DEEPSEEK_API_KEY)
DEV_OC4_GATEWAY_TOKEN=***                    # Gateway-Token oc4 (GH-Secret DEV_OC4_GATEWAY_TOKEN)
DEV_OC4_OPENROUTER_API_KEY=***                # OpenRouter-API-Key – Web-Search oc4 (Betreiber-Entscheidung 2026-08-13 17:00: statt Perplexity; GH-Secret DEV_OC4_OPENROUTER_API_KEY; sk-or-Key -> OpenRouter-Routing, Doku: docs/tools/perplexity-search.md)
# Telegram-Bot-Token je Person (S4; Q3 beantwortet – PLATZHALTER-IDs person1/person2, echte BotFather-Tokens nachlieferbar)
DEV_OC4_TELEGRAM_BOT_PERSON1=123456789:AA...  # BotFather-Token Person "person1" (Platzhalter, Q3)
DEV_OC4_TELEGRAM_BOT_PERSON2=123456789:BB...  # BotFather-Token Person "person2" (Platzhalter, Q3)
# Hinweis: Werte NIE committen – nur als GH-Secrets setzen (Workflow 04 reicht sie in den
# Container durch, openclaw.json enthaelt nur "${ENV}"-SecretRefs). .env ist via .gitignore ausgeschlossen.

# --- Qdrant ---
QDRANT_PORT=6333

# --- Docker ---
DOCKER_NETWORK=traefik-network

# Pflicht-Secrets (GH-Secrets, K3-2)
# TRAEFIK_DASHBOARD_AUTH: Format "user:<bcrypt-hash>" (htpasswd -nbB <user> <passwort>) – ADR-019
# CODE_SERVER_PASSWORD / CODE_SERVER_SUDO_PASSWORD: code-server-Zugangsdaten (GH-Secrets, Pflicht)
# CODE_SERVER_VERSION: Pin (ADR-017) – SSoT group_vars/all.yml; CODE_SERVER_HOSTNAME wird vom Workflow gesetzt

# --- Cloud-Init ---
CLOUD_SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEkOYAaYV2j6PDXHAbND5BjkpTEeUZXcYp3zJ5H0gdbw iac4-deploy-key-20260730"
