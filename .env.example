# IaC4 – Secrets-Referenz
# Kopieren nach .env und ausfüllen.
# Alle Secrets werden via GH Actions Secrets verwaltet (nicht committen).

# --- GitHub ---
GH_TOKEN=***                           # PAT mit repo + workflow scope
GIT_BOT_EMAIL=***                        # Git-Committer (Workflow 00)

# --- VPS Zugang (für manuelle Tests) ---
VPS_USER=deploy-user
VPS_DEV_PUBLIC_IP=1.2.3.4          # Public-IP für Workflow 02 (Bootstrap)
VPS_PROD_PUBLIC_IP=1.2.3.4         # Public-IP für PROD-Bootstrap (Secret noch nicht gesetzt)
VPS_SSH_KEY_PATH=~/.ssh/id_ed25519 # private Key (GH Secret: SSH_KEY)

# --- Tailscale ---
TAILSCALE_TAILNET=tailcfea8a.ts.net
TAILSCALE_OAUTH_CLIENT_ID=xxx
TAILSCALE_OAUTH_CLIENT_SECRET=***
TAILSCALE_API_KEY=xxx                    # NUR Workflow 01 (Terraform-Provider, Bootstrap); 02/03/04 nutzen OAuth-Client-Token
TAILSCALE_HOSTNAME_DEV=vps-dev
TAILSCALE_HOSTNAME_PROD=vps-prod
# Hinweis: VPS_DEV_HOST/VPS_PROD_HOST sind NICHT mehr nötig —
# die Tailscale-IP wird zur Laufzeit per Tailscale-API aufgelöst (Workflow 02/03).

# --- Traefik (Let's Encrypt) ---

# --- Code-Server ---
CODE_SERVER_PASSWORD=changeme
CODE_SERVER_SUDO_PASSWORD=changeme
CODE_SERVER_HOSTNAME=code.example.com

# --- OpenClaw ---
OPENCLAW_LLM_PROVIDER=anthropic            # oder openai, google
OPENCLAW_LLM_API_KEY=***
OPENCLAW_WEBSEARCH_API_KEY=***
OPENCLAW_GATEWAY_PORT=18789

# --- Qdrant ---
QDRANT_PORT=6333

# --- Docker ---
DOCKER_NETWORK=traefik-network

# Pflicht-Secrets (GH-Secrets, K3-2)
# TRAEFIK_DASHBOARD_AUTH: Format "user:<bcrypt-hash>" (htpasswd -nbB <user> <passwort>) – ADR-019
# CODE_SERVER_PASSWORD / CODE_SERVER_SUDO_PASSWORD: code-server-Zugangsdaten

# --- Cloud-Init ---
CLOUD_SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEkOYAaYV2j6PDXHAbND5BjkpTEeUZXcYp3zJ5H0gdbw iac4-deploy-key-20260730"
