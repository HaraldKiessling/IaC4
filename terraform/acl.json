{
    "tagOwners": {
        "tag:ia4": ["autogroup:admin"],
        "tag:ci": ["autogroup:admin"]
    },
    "acls": [
        {
            "action": "accept",
            "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
            "dst": ["tag:ia4:*"]
        },
        {
            "action": "accept",
            "src": ["tag:ia4"],
            "dst": ["tag:ia4:*"]
        }
    ],
    "ssh": [
        {
            "action": "accept",
            "src": ["autogroup:admin", "autogroup:member", "tag:ci"],
            "dst": ["tag:ia4"],
            "users": ["deploy-user", "root", "ubuntu"]
        }
    ]
}
