#cloud-config
# IaC4 – VPS-Provisioning (Template)
# SSH-Key ersetzen, tailscale wird via Ansible installiert

users:
  - name: deploy-user
    sudo: ALL=(ALL) NOPASSWD:***
    groups: sudo
    shell: /bin/bash
    ssh_authorized_keys:
      - "ssh-ed25519 AAAA...  # PUBLIC-KEY EINSETZEN"

ssh_pwauth: false
disable_root: true
package_update: true

packages:
  - curl
  - wget
  - htop
  - unzip
  - ufw

runcmd:
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow ssh
  - ufw --force enable
  - fallocate -l 2G /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
  - sysctl -w vm.swappiness=1
