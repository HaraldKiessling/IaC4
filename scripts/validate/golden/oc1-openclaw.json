{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "allowTailscale": true,
      "token": "tok"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "deepseek/deepseek-v4-flash",
        "fallbacks": [
          "deepseek/deepseek-v4-pro",
          "google/gemini-3.5-flash"
        ]
      },
      "memorySearch": {
        "provider": "local"
      },
      "subagents": {
        "delegationMode": "suggest",
        "maxChildrenPerAgent": 5,
        "maxConcurrent": 4,
        "maxSpawnDepth": 1,
        "runTimeoutSeconds": 900
      }
    }
  },
  "memory": {
    "backend": "qmd"
  },
  "plugins": {
    "entries": {
      "perplexity": {
        "enabled": false
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "none"
      }
    }
  },
  "models": {
    "providers": {
      "ollama": {
        "api": "ollama",
        "baseUrl": "http://ollama:11434"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": false
    }
  }
}
